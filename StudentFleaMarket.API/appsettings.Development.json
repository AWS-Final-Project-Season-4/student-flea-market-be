{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=StudentFleaMarketDb;Username=fleamarket_app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Email": {
    "LogOnly": true,
    "LogOnFailure": true
  },
  "UseInMemoryDatabase": false,

  "//SeedDemoData": "Dữ liệu mẫu để test nhanh (tìm kiếm / đăng bán / gỡ bán). Mặc định CHỈ bật ở Development.",
  "SeedDemoData": true,

  "//SkipDemoDataSeed": "Đặt true để tắt dữ liệu demo ở Development.",
  "SkipDemoDataSeed": false,

  "//SkipDatabaseSeed": "Tắt toàn bộ seed (kể cả admin + danh mục).",
  "SkipDatabaseSeed": false,

  "MediaStorage": {
    "BucketName": "student-market-local-images",
    "Region": "ap-southeast-1",
    "ServiceUrl": "http://localhost:4566",
    "ForcePathStyle": true
  }
}
